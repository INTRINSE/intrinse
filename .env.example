# Diese Datei enthält KEINE echten Werte — nur die Namen der Environment
# Variablen, die in den Vercel-Projekteinstellungen hinterlegt werden müssen
# (Settings → Environment Variables). Siehe docs/ für die Einrichtung.

# Token, den die IT-Recht Kanzlei im <user_auth_token>-Element sendet.
IT_RECHT_KANZLEI_TOKEN=

# Fine-grained GitHub Personal Access Token mit "Contents: Read and write"
# nur für dieses eine Repository.
GITHUB_TOKEN=

# z. B. SudoAdeline/intrinse
GITHUB_REPO=

# Standard: main
GITHUB_BRANCH=main
